# This file intentionally contains no secrets.
# Optional non-secret configuration overrides. TOML settings are overridden by these values.
ILIAS_MCP_INSTANCE_ID=stuttgart
ILIAS_MCP_INSTANCE_URL=https://ilias3.uni-stuttgart.de
ILIAS_MCP_TIMEZONE=Europe/Berlin
ILIAS_MCP_CACHE_TTL_SECONDS=300
ILIAS_MCP_ARTIFACT_DIRECTORY=.ilias-mcp/artifacts
ILIAS_MCP_ARTIFACT_RETENTION_HOURS=24
ILIAS_MCP_MAX_ARTIFACT_BYTES=26214400
ILIAS_MCP_REQUESTS_MAX_PER_MINUTE=20
ILIAS_MCP_REQUESTS_MAX_CONCURRENT=2
ILIAS_MCP_RESULTS_DEFAULT_LIMIT=50
ILIAS_MCP_RESULTS_MAX_LIMIT=100
